# Post-install / post-upgrade messaging for xdg-utils-handlr.

post_install() {
    cat <<'EOF'
==> xdg-utils-handlr has replaced xdg-utils on this system.
==>
==>   xdg-open  and  xdg-mime query/default  are now served by handlr-regex.
==>   xdg-mime install/uninstall and the other six xdg-* tools remain the
==>   unmodified upstream scripts.
==>
==> To revert to plain xdg-utils at any time:
==>   sudo pacman -S xdg-utils
==>
==> Known edge cases: see docs/EDGE_CASES.md in the source repository.
EOF
}

post_upgrade() {
    post_install
}
