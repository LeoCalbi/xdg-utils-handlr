#!/bin/sh
# xdg-open shim that redirects to handlr-regex (https://github.com/Anomalocaridid/handlr-regex)
#
# Ships as part of xdg-utils-handlr, a drop-in replacement package for
# xdg-utils (provides/conflicts xdg-utils) so dependents keep resolving.
#
# Documented xdg-open contract (xdg-open(1), xdg-utils):
#   xdg-open { file | URL }
#   xdg-open { --help | --manual | --version }
# Exit codes: 0 success, 1 syntax error, 2 file not found,
#             3 required tool not found, 4 action failed.

set -eu

PROG="xdg-open"

usage() {
    cat <<EOF
Usage: $PROG { file | URL }
       $PROG { --help | --manual | --version }
EOF
}

case "${1:-}" in
    --help)
        usage
        exit 0
        ;;
    --manual)
        # Upstream implements --manual as a plain-text copy of the man page
        # embedded in the script. This package installs the genuine,
        # unmodified upstream man pages, so render the real one rather than
        # keeping a hand-written summary that can drift out of date.
        # `man -w` confirms a page is actually installed before exec'ing,
        # so running from a source checkout (or without man-db) falls back
        # instead of dying with man's "No manual entry" exit 16.
        if command -v man >/dev/null 2>&1 && man -w "$PROG" >/dev/null 2>&1; then
            exec man "$PROG"
        fi
        usage
        echo
        echo "The full manual is installed as a man page: \`man $PROG\`"
        echo "(requires man-db, and the xdg-utils-handlr package to be installed)"
        echo
        echo "This is a handlr-regex shim for $PROG (xdg-utils-handlr package)."
        echo "See: https://github.com/Anomalocaridid/handlr-regex"
        exit 0
        ;;
    --version)
        if command -v handlr >/dev/null 2>&1; then
            printf 'xdg-open shim (handlr-regex backend, xdg-utils-handlr package)\n'
            handlr --version
        else
            echo "handlr: command not found" >&2
            exit 3
        fi
        exit 0
        ;;
    "")
        usage >&2
        exit 1
        ;;
esac

case "$1" in
    -*)
        echo "$PROG: unrecognized option '$1'" >&2
        usage >&2
        exit 1
        ;;
esac

if [ "$#" -gt 1 ]; then
    echo "$PROG: too many arguments" >&2
    usage >&2
    exit 1
fi

TARGET="$1"

if ! command -v handlr >/dev/null 2>&1; then
    echo "$PROG: handlr: required tool not found" >&2
    exit 3
fi

# Treat anything that starts with a well-formed URI scheme (RFC 3986:
# ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ) ":") as a URI and let
# handlr resolve it; otherwise require the path to exist locally.
is_uri=0
case "$TARGET" in
    [a-zA-Z]*:*)
        scheme="${TARGET%%:*}"
        rest="${scheme#?}"
        case "$rest" in
            *[!a-zA-Z0-9+.-]*) ;;
            *) is_uri=1 ;;
        esac
        ;;
esac

if [ "$is_uri" -eq 0 ] && [ ! -e "$TARGET" ]; then
    echo "$PROG: file '$TARGET' does not exist" >&2
    exit 2
fi

# handlr raises a desktop notification when a command fails and *panics*
# (SIGABRT, exit 134) if no session bus is reachable -- cron jobs, systemd
# units, ssh sessions, container builds. `-n` prevents that, but a handlr
# run with `-n` then exits 0 even when it failed, so success is judged from
# stderr instead: empty on success, an ERROR/WARN line on failure.
#
# stdout is routed to the real stdout through fd 3 rather than captured, so
# a Terminal=true handler still talks to the terminal; only stderr goes
# through the substitution, and it is replayed below.
exec 3>&1
err=$(handlr open -n -- "$TARGET" 2>&1 1>&3 3>&-) || :
exec 3>&-

if [ -n "$err" ]; then
    printf '%s\n' "$err" >&2
    exit 4
fi
exit 0
